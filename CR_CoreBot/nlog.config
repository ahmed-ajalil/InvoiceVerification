<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="info"
      throwConfigExceptions="true">

  <extensions>
    <add assembly="NLog.Web.AspNetCore"/>
    <add assembly="NLog.Extensions.AzureBlobStorage" />
  </extensions>

  <targets async="true">
    <target
      xsi:type="AzureBlobStorage"
      name="azure"
      layout="${longdate:universalTime=true} ${level:uppercase=true} - ${logger}: ${message} ${exception:format=tostring}"
      connectionString="DefaultEndpointsProtocol=https;AccountName=opevaitesege1;AccountKey=rydsvhdh437vhvdsnbdfy84rbjjh;EndpointSuffix=core.windows.net"
      container="industryailog"
      blobName="${date:universalTime=true:format=yy-MM-dd}.log" />
  </targets>

  <rules>
    <logger name="*" minlevel="Trace" writeTo="azure" />
    <!--<logger name="Microsoft.*" maxlevel="Info" writeTo="azure" />-->
  </rules>

</nlog>