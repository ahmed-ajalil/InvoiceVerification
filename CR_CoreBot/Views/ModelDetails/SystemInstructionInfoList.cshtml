@model IEnumerable<CR_HRPortalAI_DataAcess.CR_HRPortal.SystemInstructionsDTO>

@{
    ViewData["Title"] = "SystemInstructionInfoList";
    Layout = "~/Views/Shared/_ServiceLayout.cshtml";
}

@section CssForThisPage {
    <!-- DataTables -->
    <link href="~/content/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="~/content/assets/libs/datatables.net-buttons-bs4/css/buttons.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="~/content/assets/css/style.css" rel="stylesheet" />
    <link href="~/content/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="~/content/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <style>
        table.dataTable {
            margin-top: 0 !important;
        }

        .ctm-table th {
            background-color: #f2f2f2 !important;
            color: #000 !important;
            font-size: 14px !important;
        }
    </style>
}

@Html.AntiForgeryToken()
<div class="row">
    <div class="col-md-6">
        <h4 class="mb-sm-0 font-size-18">System Instruction Information Data</h4>
    </div>
    <div class="col-md-6 text-end">
        <a class="btn btn-info btn-sm" href="@Url.Action("SystemInstructionInfo", "ModelDetails")"><i data-feather="user" class="icon-sm"></i> Add System Instruction</a>
    </div>
</div>

<div class="row mb-5">
    <div class="col-md-12">
        <div class="card mb-3">
            <div class="card-body p-2">
                <table id="tblResponse" class="table table-bordered table-striped" style="width:100%;">
                    <thead class="ctm-table">
                        <tr>
                            <th style="min-width:100px">System Instruction Activated</th>
                            <th>Rules</th>
                            <th style="min-width:50px">Industry</th>
                            <th style="min-width:100px">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var latestId = Model.FirstOrDefault(m => m.Status == 1)?.Id;
                            var defaultInstructionId = Model.FirstOrDefault(m => m.DefaultType == 1)?.Id;
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <label>
                                        <input type="radio" name="SystemInstructionActivated" value="@item.Id" @(item.Id == latestId ? "checked" : "") onclick="setActivatedInstruction(this)" />
                                        @if (item.Id == defaultInstructionId)
                                        {
                                            <span style="color: black; font-weight: bold; font-style: italic;">Default</span>
                                        }
                                    </label>
                                </td>
                                <td>
                                    <textarea class="form-control" id="Rules" readonly="true" style="height: 500px; width:850px">@item.Rules</textarea>
                                </td>
                                <td>@item.Industry</td>
                                <td>
                                    <button type="button" class="btn btn-primary btn-sm" onclick="Edit(@item.Id)">Edit</button>
                                    <button type="button" class="btn btn-danger btn-sm" onclick="Delete(@item.Id)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section JSForThisPage {
    <script src="~/content/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/content/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/content/assets/libs/sweetalert2/sweetalert2.min.js"></script>
    <script src="~/js/modeldetailssysteminstructioninfolist.js"></script>

    <script>
      

        var showWarning = '@TempData["ShowWarning"]';
        var warningMessage = '@TempData["WarningMessage"]';
    </script>
}
