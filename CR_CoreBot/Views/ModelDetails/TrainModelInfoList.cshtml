@model IEnumerable<CR_HRPortalAI_DataAcess.CR_HRPortal.TrainModelDTO>
@{
    ViewData["Title"] = "TrainModelInfoList";
    Layout = "~/Views/Shared/_ServiceLayout.cshtml";
}

@section CssForThisPage {
    <!-- DataTables -->
    <link href="~/content/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="~/content/assets/libs/datatables.net-buttons-bs4/css/buttons.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <!-- Responsive datatable examples -->
    <link href="~/content/assets/css/style.css" rel="stylesheet" />
    <link href="~/content/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="~/content/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <style>
        table.dataTable {
            margin-top: 0 !important;
        }

        .dataTables_length label {
            display: inline-flex;
        }

            .dataTables_length label select {
                margin-left: 5px !important;
            }

        .ctm-table th {
            background-color: #f2f2f2 !important;
            color: #000 !important;
            font-size: 14px !important;
        }
    </style>
}

<div class="row">
    <div class="col-md-6">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18">Train Model Data</h4>
        </div>
    </div>
    <div class="col-md-6 text-end">
        <div class="RptLytTpMenu">
            <ul>
                <li>
                
                    <a class="btn btn-info btn-sm" href='@Url.Action("TrainModelInfo","ModelDetails")'><i data-feather="user" class="icon-sm"></i> Add Question & Query </a>
                </li>
            </ul>
        </div>
    </div>
</div>
<div class="row mb-5">
    <div class="col-md-12">
        <div class="card mb-3">
            <div class="card-body p-2">
                <table id="tblResponse" class="table table-bordered table-striped" style="width:100%;">
                    <thead class="ctm-table">
                        <tr>
                            <th style="min-width:200px">Question</th>
                            <th style="min-width:200px">SQL Query</th>
                            <th style="min-width:120px">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Question</td>
                                <td>@item.SQLQuery</td>
                                <td>
                                    <button type="button" class="btn btn-primary btn-sm" onclick="Edit(@item.Id)">Edit</button>
                                    <button type="button" class="btn btn-danger btn-sm" onclick="Delete(@item.Id)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editModalLabel">Edit Question and SQL Query</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editForm">
                    <input type="hidden" id="editId" name="Id" />
                    <div class="mb-3">
                        <div class="form-floating">
                            <textarea class="form-control" id="editQuestion" name="Question" placeholder="Enter question" required style="height: 100px"></textarea>
                            <label for="editQuestion">Enter question</label>
                        </div>
                        <span class="text-danger" id="error-question"></span> <!-- Error display -->
                    </div>
                    <div>

                        <div class="form-floating">
                            <textarea class="form-control" id="editSQLQuery" name="SQLQuery" placeholder="Enter SQL Query" required style="height: 100px"></textarea>
                            <label for="editSQLQuery">SQL Query</label>
                        </div>
                        <span class="text-danger" id="error-sqlquery"></span> <!-- Error display -->
                    </div>
                    
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="Updatebtn" class="btn btn-info px-5" onclick="SaveTrainModelInfo('update')">Update</button>
            </div>
        </div>
    </div>
</div>

@section JSForThisPage {
    <script src="~/content/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/content/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/content/assets/libs/sweetalert2/sweetalert2.min.js"></script>
   

    <script src="~/js/modeldetailstrainmodelinfolist.js"></script>

     
}
