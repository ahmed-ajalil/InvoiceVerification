
@{
    ViewData["Title"] = "CustomerConfiguration";
    Layout = "~/Views/Shared/_ServiceLayout.cshtml";
}
<style>
    li {
        list-style: none;
    }
</style>
@section CssForThisPage{
    <link href="~/content/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
}
<div class="row">
    <div class="col-md-6">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18">Customer Configuration</h4>
        </div>
    </div>

    <div class="col-md-6 text-end">
        
        <ul>
            <li>
                
                <a class="btn btn-info btn-sm" href='@Url.Action("CustomerConfigurationList","Admin")'><i data-feather="chevrons-left" class="icon-sm"></i>&nbsp;Back</a>
            </li>
        </ul>
        
    </div>

</div>
<div class="row">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body">
                @*<form>*@
                <div class="row">
                    <div class="col-lg-6">
                        <div>

                            <div class="form-group mb-3">
                                <label for="example-text-input" class="form-label">Username</label>
                                <input type="text" id="username" class="form-control" />

                            </div>

                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div>
                            <div class="mt-3 mt-lg-0">
                                <div class="form-group mb-3">
                                    <label for="OrganizationName" class="form-label">No. Of Files Allowed</label>
                                    <input type="text" id="filesallowed" class="form-control" />
                                </div>

                            </div>

                        </div>
                    </div>



                    <div class="col-lg-6">
                        
                        <div class="form-group mb-3">
                            <label for="example-text-input" class="form-label">No. Of Users Allowed</label>
                            <input type="text" id="usersallowed" class="form-control" autocomplete="off" />
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <label for="example-text-input" class="form-label">Files Format Allowed</label>
                        <div class="form-group mb-3">
                        
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="Pdf" name="checkbox1" value="Pdf">
                            <label class="form-check-label" for="Pdf">Pdf</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="Word" name="checkbox2" value="Word">
                            <label class="form-check-label" for="Word">Word</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="Csv" name="checkbox3" value="Csv">
                            <label class="form-check-label" for="Csv">Csv</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="Image" name="checkbox3" value="Image">
                            <label class="form-check-label" for="Image">Image</label>
                        </div>
                        </div>
                    </div>
                    

                    @*<div class="col-6">
                        <div>
                            <input type="checkbox" id="Pdf" name="checkbox1">
                            <label for="checkbox1">Pdf</label>
                        </div>

                        <div>
                            <input type="checkbox" id="Word" name="checkbox2">
                            <label for="checkbox2">Word</label>
                        </div>

                        <div>
                            <input type="checkbox" id="Csv" name="checkbox3">
                            <label for="checkbox3">Csv</label>
                        </div>

                        <div>
                            <input type="checkbox" id="Image" name="checkbox4">
                            <label for="checkbox4">Image</label>
                        </div>
                    </div>*@

                    @*<div class="col-lg-6">
                    <div class="mt-3 mt-lg-0">
                    <div class="form-group mb-3">
                    <label for="Role" class="form-label">Role</label>
                    <select class="form-control" id="Role">
                    <option value="">-- Select Role --</option>
                    <option value="1">Admin</option>
                    <option value="2">SuperAdmin</option>
                    <option value="3">User</option>
                    </select>

                    </div>
                    </div>
                    </div>*@

                    <br />

                    <div class="card border-0 bg-transparent mb-0">
                        <div class="card-body text-end position-bottom p-0 mb-0">
                            <div class="mb-0">
                                <button type="submit" class="btn btn-info btn-sm px-3" style="float:right;" id="Insertbtn" onclick="SaveCustomerConfiguration()">Save Customer Configuration</button>
                                <button  class="btn btn-info btn-sm"  style="float:right;display:none" id="Updatebtn" onclick="UpdateCustomerConfiguration()"><i data-feather="refresh-ccw" class="icon-sm"></i>&nbsp; Update Customer Configuration</button>
                            </div>

                        </div>
                    </div>

                </div>
                @*</form>*@
            </div>
        </div>
    </div>
</div>

 

@section JSForThisPage {
    <script src="~/content/assets/libs/sweetalert2/sweetalert2.min.js"></script>
    <script src="~/js/admincustomerconfiguration.js"></script>
}
 


