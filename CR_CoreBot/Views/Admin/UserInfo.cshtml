@*  @model CR_CoreBot_DTO.CustomerInformationModel *@

@{
    ViewData["Title"] = "CustomerInfo";
    Layout = "~/Views/Shared/_ServiceLayout.cshtml";
}
<style>
    li {
        list-style: none;
    }
</style>

@section CssForThisPage {
    <link href="~/content/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
}

<div class="row">
    <div class="col-md-6">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18">User Information</h4>
        </div>
    </div>

    <div class="col-md-6 text-end">
        <ul>
            <li>
                 
                <a class="btn btn-info btn-sm" href='@Url.Action("UserInfoList","Admin")'>
                    <i data-feather="chevrons-left" class="icon-sm"></i>&nbsp;Back
                </a>
            </li>
        </ul>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body">
                <form id="userInfoForm">
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="form-group mb-3">
                                <label for="firstname" class="form-label">First Name</label>
                                <input type="text" id="firstname" class="form-control" />
                            </div>

                            <div class="form-group mb-3">
                                <label for="username" class="form-label">UserName</label>
                                <input type="text" id="username" class="form-control" autocomplete="off" />
                            </div>

                            <div class="form-group mb-3">
                                <label for="Streaming" class="form-label">Streaming</label>
                                <div id="Streaming" class="form-control">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="streaming" id="streamingOn" value="1" checked>
                                        <label class="form-check-label" for="streamingOn">On</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="streaming" id="streamingOff" value="0">
                                        <label class="form-check-label" for="streamingOff">Off</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="form-group mb-3">
                                <label for="lastname" class="form-label">Last Name</label>
                                <input type="text" id="lastname" class="form-control" />
                            </div>

                            <div class="form-group mb-3">
                                <label for="password" class="form-label">Password</label>
                                <input id="password" class="form-control" type="password" autocomplete="off" />
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 bg-transparent mb-0">
                        <div class="card-body text-end">
                            <button type="button" class="btn btn-info btn-sm px-3" onclick="SaveUserInfo()" id="Insertbtn">Save User Info</button>
                            <button type="button" class="btn btn-info btn-sm" onclick="UpdateUserInfo()" id="Updatebtn" style="display:none;">
                                <i data-feather="refresh-ccw" class="icon-sm"></i>&nbsp; Update User Info
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/assets/libs/jquery/jquery.min.js"></script>

@section JSForThisPage {
    <script src="~/content/assets/libs/sweetalert2/sweetalert2.min.js"></script>
    <script src="~/js/adminuserinfo.js"></script>
}
