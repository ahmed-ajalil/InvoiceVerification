                         <label for="OpenaiApiKey">OpenaiApiKey:</label>
                      </div>
                      <input type="password" id="openaiApiKey" class="form-control">
                   </div>
                </div>
                <div class="form-check form-check-inline p-0">
                   <div class="row my-3">
                      <div class="col-md-8 ps-0">
