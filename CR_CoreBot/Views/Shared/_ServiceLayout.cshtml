                   <div class="col-md-8 ps-0">
                      <label for="temperature">Temperature:</label>
                   </div>
                   <div class="col-md-4 text-end">
                      <span class="badge bg-secondary px-2" id="temperatureValue"></span>
                   </div>
                   <input type="range" id="temperatureRange" min="0" max="1" step="0.1" value="">
                </div>
                <div class="form-check p-0">
                   <div class="row my-3">
                      <div class="col-md-8 ps-0">
                         <label for="maxTokens">MaxTokens:</label>
                      </div>
                      <div class="col-md-4 text-end">
                         <span class="badge bg-secondary px-2" id="maxTokensValue"></span>
                      </div>
                      <input type="range" id="maxTokensRange" min="0" step="100" max="3000" value="">
                   </div>
                </div>
                <div class="form-check form-check-inline p-0">
