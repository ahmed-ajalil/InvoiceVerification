        var Category = loginData.Category;
        var link = "";
        if(Category != null)
        {
            var splittedcategory = Category.Substring(0, Category.IndexOf("Model"));
            link = "/"+splittedcategory +"/"+splittedcategory+"Bot/bot";
        }
