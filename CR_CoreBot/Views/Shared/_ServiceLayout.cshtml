    <div class="offcanvas offcanvas-end bg-light" tabindex="-1" id="offcanvasRight" aria-labelledby="offcanvasRightLabel">
       <div class="offcanvas-header bg-info bg-gradient">
          <h5 id="offcanvasRightLabel" class="mb-0 text-white">Bot Configuration</h5>
          <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
       </div>
       <div class="offcanvas-body">
          <div class="p-2 border-1">
             <div class="form-check form-check-inline p-0">
                <div class="row my-1">
                   <div class="col-md-8 ps-0 text-start">
