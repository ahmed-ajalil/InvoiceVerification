        <!-- ============================================================== -->
        <!-- Start right Content here -->
        <!-- ============================================================== -->
        <div class="main-content mt-2">
            <div class="page-content px-2">
                <div class="container-fluid">
                    @RenderBody()
                </div> <!-- container-fluid -->
            </div>
            <!-- End Page-content -->
            @*<footer class="footer">
            <div class="container-fluid">
            <div class="row">
            <div class="col-sm-6">
            <div class="">
