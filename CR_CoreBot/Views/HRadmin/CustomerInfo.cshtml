@model CR_CoreBot_DTO.CustomerInformationHRDTO

@{
    ViewData["Title"] = "CustomerInfo";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">Customer Information</h4>
            </div>
            <form asp-action="CustomerInfo">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row">
                    <div class="col-lg-6">
                        <div>
                            <div class="form-group mb-3">
                                <label asp-for="UserName" class="control-label"></label>
                                <input asp-for="UserName" class="form-control" />
                                <span asp-validation-for="UserName" class="text-danger"></span>
                            </div>
                            <div class="form-group mb-3">
                                <label asp-for="Password" class="control-label"></label>
                                <input asp-for="Password" class="form-control" type="password" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                            <div class="form-group mb-3">
                                <label asp-for="Name" class="control-label"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="form-group mb-3">
                                <label asp-for="OrganizationName" class="control-label"></label>
                                <input asp-for="OrganizationName" class="form-control" />
                                <span asp-validation-for="OrganizationName" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="mt-3 mt-lg-0">
                            <div class="form-group mb-3">
                                <label asp-for="OrganizationLogo" class="control-label"></label>
                                <input asp-for="OrganizationLogo" class="form-control" />
                                <span asp-validation-for="OrganizationLogo" class="text-danger"></span>
                            </div>
                            <div class="form-group mb-3">
                                <label asp-for="DatabaseName" class="control-label"></label>
                                <input asp-for="DatabaseName" class="form-control" />
                                <span asp-validation-for="DatabaseName" class="text-danger"></span>
                            </div>
                            <div class="form-group mb-3">
                                <label asp-for="Category" class="control-label"></label>
                                <input asp-for="Category" class="form-control" />
                                <span asp-validation-for="Category" class="text-danger"></span>
                            </div>
                        </div>
                        <br />
                        <div class="form-group">
                            <input type="submit" value="Create" class="btn btn-primary" style="float:right;" />
                        </div>
                    </div>
                </div>
            </form>

        </div>
    </div>
</div>
<script src="~/content/assets/libs/jquery/jquery.min.js"></script>
<script src="~/script/sweetalert.min2.js"></script>
<script src="~/js/hradmincustomerinfo.js"></script>
<script src="~/js/hradmincustomerinfo.js"></script>

