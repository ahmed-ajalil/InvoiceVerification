@model IEnumerable<CR_HRPortalAI_DataAcess.CR_HRPortal.ModelFineTuneDatum>

@{
    ViewData["Title"] = "ModelFineTuneModel";
    Layout = "~/Views/Shared/_ServiceLayout.cshtml";
}
@section CssForThisPage{

    <link href="~/content/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
}

<div class="row">
    <div class="col-md-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18">Model FineTune Data Configuration</h4>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body bg-light p-3">
                <form>
                    <div class="text-danger"></div>
                    <div class="row">
                        <div class="col-lg-6">
                            <div>

                                <div class="mb-3">
                                    <label class="control-label">Prompt</label>
                                    <input type="text" id="prompt" class="form-control" />

                                </div>

                                <div class="mb-3">
                                    <label class="control-label">Completion</label>
                                    <input type="text" id="completion" class="form-control" />
                                </div>

                                <div class="mb-3">
                                    <label class="control-label">Document Reference</label>
                                    <input type="text" id="url" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="mt-3 mt-lg-0">
                                <div class="mb-3">
                                    <label class="control-label">Label</label>
                                    <input type="text" id="label" class="form-control" />
                                </div>

                                <div class="mb-3">
                                    <label class="control-label">Select Model</label>
                                    <select class="form-control" id="ModelName">
                                        <option value="">-- Select Model Name --</option>
                                    </select>
                                </div>

                            </div>
                            
                        </div>
                        <div class="col-md-12">
                            <div class="mb-3">
                                <button onclick="SaveModelFineTuneData()" class="btn btn-primary" id="Insertbtn" style="float:right;"> Insert Model Fine Tune Data</button>
                                <button onclick="UpdateModelFineTuneData()" class="btn btn-primary" id="Updatebtn" style="float:right;display:none"> Update Model Fine Tune Data </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="~/content/assets/libs/jquery/jquery.min.js"></script>
@*<script src="~/script/sweetalert.min2.js"></script>*@

@section JSForThisPage {
    <script src="~/content/assets/libs/sweetalert2/sweetalert2.min.js"></script>
    

    <script src="~/js/hradmineditmodelfinetunedata.js"></script>

     
    }