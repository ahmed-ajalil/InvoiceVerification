                data.ConnectionString = RedirectURI;
                data.storageType = storageType;
                $.ajax({
                    url: "/HRadmin/BlobConnection/",
                    type: "POST",
                    data: data,
                    async: true,
                    success: function (responseData) {
                        console.log(responseData);
                        hide_loader();
                        if (responseData == 'succesfully') {
                            $("#FileUpload").css("display", "block");
                            new swal({
                                title: "Success",
                                text: "Sync Done successfully",
                                icon: "success"
                            })
                        }
                        else if (responseData == "Account Doesn't exist") {
                            new swal({
                                title: "Error",
                                text: "Account Doesn't exist",
                                icon: "error"
                            }).then((result) => {
                                if (result) {
                                    window.location.href = '/Admin/CustomerInfo?CustomerId=0/';
                                }
                            });
                        }
                        else {
                            new swal({
                                title: "Error",
                                text: responseData,
                                icon: "error"
                            });
                        }
                    },
                    failure: function (responseData) {
                        hide_loader();
                    },
                    error: function (responseData) {
                        hide_loader();
                    }
                })

            }
        }
        function SaveAWSBucketInfo() {
            var keyName = $("#keyName").val();
            var bucketName = $("#bucketName").val();
            var storageType = $('input[name="storageType"]:checked').val();
            if (keyName == "" || keyName == undefined) {
                new swal({
                    title: "Error",
                    text: "keyName can't be empty",
                    icon: "error"
                });
            }
            else if (bucketName == "" || bucketName == undefined) {
                new swal({
                    title: "Error",
                    text: "bucketName can't be empty",
                    icon: "error"
                });
            }
            else {
                show_loader();
                var data = {};
                data.AccountKey = keyName;
                data.AccountName = bucketName;
                data.storageType = storageType;
                $.ajax({
                    url: "/HRadmin/BlobConnection/",
                    type: "POST",
                    data: data,
                    async: true,
                    success: function (responseData) {
                        console.log(responseData);
                        hide_loader();
                        if (responseData == 'succesfully') {
                            $("#FileUpload").css("display", "block");
                            new swal({
                                title: "Success",
                                text: "Sync Done successfully",
                                icon: "success"
                            })
                        }
                        else if (responseData == "Account Doesn't exist") {
                            new swal({
                                title: "Error",
                                text: "Account Doesn't exist",
                                icon: "error"
                            }).then((result) => {
                                if (result) {
                                    window.location.href = '/Admin/CustomerInfo?CustomerId=0/';
                                }
                            });
                        }
                        else {
                            new swal({
                                title: "Error",
                                text: responseData,
                                icon: "error"
                            });
                        }
                    },
                    failure: function (responseData) {
                        hide_loader();
                    },
                    error: function (responseData) {
                        hide_loader();
                    }
                })

            }
        }
        //
        function fnUploadMultiplefiles() {
            var accountName = $("#AccountName").val();
            var files = $('#imageFiles')[0].files;
            var Checkfile = $('#imageFiles').val();
            var storageType = $('input[name="storageType"]:checked').val();
            if (Checkfile == "") {
                new swal({
                    title: "Error",
                    text: "Please select an file",
                    icon: "error"
                });
            }
            if (files.length > 0) {
                show_loader();
                var formData = new FormData();
                for (var i = 0; i < files.length; i++) {
                    formData.append('images', files[i]);
                    formData.append('accountName', accountName);
                    formData.append('storageType', storageType);
                }
                $.ajax({
                    url: '/HRadmin/syncFileData',
                    type: 'POST',
                    data:  formData,
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        hide_loader();
                        if (response == "Success") {
                            new swal({
                                title: "Success",
                                text: "All File Upload successfully",
                                icon: "success"
                            });
                        }
                        else {
                            new swal({
                                title: "Error",
                                text: "Failed!!",
                                icon: "error"
                            });
                        }

                    },
                    error: function (xhr, status, error) {
                        hide_loader();
                        new swal({
                            title: "Error",
                            text: "Failed!!",
                            icon: "error"
                        });
                    }
                });
            }
        }
    </script>
	<script>
		$('[name=storageType]').each(function(i,d){
			  var p = $(this).prop('checked');
			//   console.log(p);
			  if(p){
				$('.rd-grp').eq(i)
				  .addClass('on');
			  }    
			});  

			$('[name=storageType]').on('change', function(){
			  var p = $(this).prop('checked');
			  
			  // $(type).index(this) == nth-of-type
			  var i = $('[name=storageType]').index(this);
			  
			  $('.rd-grp').removeClass('on');
			  $('.rd-grp').eq(i).addClass('on');
			});
		</script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}


