                });
            }
            else if (ClientSecret == "" || ClientSecret == undefined) {
                new swal({
                    title: "Error",
                    text: "ClientSecret can't be empty",
                    icon: "error"
                });
            }
            else if (RedirectURI == "" || RedirectURI == undefined) {
                new swal({
                    title: "Error",
                    text: "RedirectURI can't be empty",
                    icon: "error"
                });
            }
            else {
                show_loader();
                var data = {};
                data.AccountName = ClientID;
