            newSugg2 = '';
            newSugg3 = '';
            $("#btnStop").hide();
        });

        function addPerformanceMatrixChecker(Prompt, Completion, RequestTokenLimit, ResponseTokenLimit, responseTime, promptTokens, completionTokens, totalTokens, cost, publicinfo) {
            var PerformanceMatrixChecker = {};
            PerformanceMatrixChecker.Prompt = Prompt;
            PerformanceMatrixChecker.Completion = Completion;
            PerformanceMatrixChecker.PromptTokens = promptTokens;
            PerformanceMatrixChecker.CompletionTokens = completionTokens;
            PerformanceMatrixChecker.ResponseTime = responseTime;
            PerformanceMatrixChecker.TotalTokens = totalTokens;
            PerformanceMatrixChecker.Cost = cost;
            PerformanceMatrixChecker.PublicInfo = publicinfo;

            $.ajax({
                url: '/PBIChatBot/PBIBot/AddPerformanceMatrixChecker',
                type: 'post',
                data: { performance: PerformanceMatrixChecker },
                success: function (response) {
                    if (response == "0") {
                        window.location.href = '@Url.Action("Index", "Login")';
                    }
                    else {
                        PerformanceId = response;

                        var targetDiv = $(PerID);
                        var currentHtml = targetDiv.html();
                        var updatedHtml = currentHtml.replace(/PerformID/gi, PerformanceId);
                        targetDiv.html(updatedHtml);
                    }
                },
                error: function (error) {
                    $('#btnS').prop('disabled', false);
                    $('#inputPrompt').prop('disabled', false);
                }
            });
        }

