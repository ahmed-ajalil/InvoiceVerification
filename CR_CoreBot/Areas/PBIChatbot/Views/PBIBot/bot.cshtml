        async function botResponse(msg) {
            streamVal = "";
            streamVal3 = "";
            var uniqueID = '';
            stopTyping = false;
            try {
                await GenerateGUID();
                uniqueID = $('#inputguid').val();
            } catch (error) {
                console.error('An error occurred:', error);
            }

            hideSuggestionsDropdown();
            $("#messageSuggestionDIV").empty();
            var hyperValue = $("#hyperInputDiv").val();
            $('#btnS').prop('disabled', true);
            $('#inputPrompt').prop('disabled', true);

            if (uniqueID != '') {
                $.ajax({
                    url: '/PBIChatbot/PBIBot/Inde',
                    type: 'GET',
                    dataType: 'json',
                    data: { PropmpInput: msg, Document: selectvalue(), personalbanking: toggleValue, OutScope: getcheckboxvalue(), HyperInput: hyperValue, DocumentType: "BankingModel", _BankingEnable: _BankingEnable, guid: uniqueID },
                    success: function (data) {
                        message = msg;
                        newSugg1 = data.newSuggestions1;
                        newSugg2 = data.newSuggestions2;
                        newSugg3 = data.newSuggestions3;
                        dynamicString = data.completionResult;
                        dataSource = data.sourceURL;
                        labelName = data.labelName;
                        promptTokens = data.promptTokens;
                        completionTokens = data.completionTokens;
                        totalTokens = data.totalTokens;
                        cost = data.cost;
                        contentSaftey = data.contentSaftey;
                        if (data.publicInfo != 1 || data.publicInfo === undefined) {
                            publicinfo = 0;
                        }
                        else {
                            publicinfo = data.publicInfo;
                        }

                        responseTime = parseFloat(data.responseTime).toFixed(2) ?? 0.0;
                        CacheVal = data["cacheStatus"];
                        if (data["cacheStatus"] == 1) {
                            appendMessage(BOT_NAME, BOT_IMG, "left", dynamicString, dataSource, labelName, contentSaftey);

                            typeEffect3($(streamVal3), dynamicString, 10);
                            $(".typing-gif").css("display", "none");
                        }
                        if (data["cacheStatus"] == 2) {
                            appendMessage(BOT_NAME, BOT_IMG, "left", dynamicString, dataSource, labelName, contentSaftey);
                            $(".typing-gif").css("display", "none");
                            setmessageSuggestion(newSugg1, newSugg2, newSugg3);
                            newSugg1 = '';
                            newSugg2 = '';
                            newSugg3 = '';
                            $('#btnS').prop('disabled', false);
                            $('#inputPrompt').prop('disabled', false);
                        }
                        var data = 2;
                        if (stopTyping == true) {
                            newSugg1 = '';
                            newSugg2 = '';
                            newSugg3 = '';
                        }
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        $(".typing-gif").css("display", "none");
                        $('#btnS').prop('disabled', false);
                        $('#inputPrompt').prop('disabled', false);
                    },
                    complete: function () {
                        CacheVal = 0;
                    }
                });
            }
        }

        function GenerateGUID() {
            return new Promise((resolve, reject) => {

                $.ajax({
                    url: '/PBIChatbot/PBIBot/GenerateGUID',
                    type: 'GET',
                    dataType: 'text',
                    success: function (data) {
                        guid = data;
                        $('#inputguid').val(guid);
                        GetIntermediateSteps(guid);
                        resolve(data);
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        console.log('Error', textStatus, errorThrown);
                        reject(errorThrown);
                    }
                });
            });
        }

        function GetIntermediateSteps(guid) {
            $.ajax({
                url: '/PBIChatbot/PBIBot/GetIntermediateSteps',
                type: 'GET',
                data: { guid: guid },
                dataType: 'json',
                success: function (data) {
                    data.forEach(item => {
                        dataSource[0] = null;
                        contentSaftey = true;
                        labelName[0] = null;
                        responseData.push(item.logs);
                        if (streamVal == "") {
                            appendMessage(BOT_NAME, BOT_IMG, "left", item.logs, dataSource, labelName, contentSaftey);
                            $(showBtn).hide();

                            typeEffect($(streamVal), item.logs, 10, item.status, item.id, streamVal2);
                        }
                        else {
                            if (item.status == 3) {
                                $(excelDownload).attr('data-custom', item.logs);
                                $(excelDownload).css("display", "block")
                                excelDownload = "";
                                GetIntermediateSteps(guid);
                            }
                            else {
                                typeEffect($(streamVal), item.logs, 10, item.status, item.id, streamVal2);
                            }

                        }
                    });
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    $(".typing-gif").css("display", "none");
                    console.log('error:', textStatus, errorThrown);
                }
            });
        }

