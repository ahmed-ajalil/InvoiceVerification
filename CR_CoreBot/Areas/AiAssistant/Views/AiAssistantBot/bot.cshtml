        });

        function addPerformanceMatrixChecker(Prompt, Completion, RequestTokenLimit, ResponseTokenLimit, responseTime, promptTokens, completionTokens, totalTokens, cost, publicinfo, responsibleAIAssessment) {
            var PerformanceMatrixChecker = {};
            PerformanceMatrixChecker.Prompt = Prompt;
            PerformanceMatrixChecker.Completion = Completion;
            PerformanceMatrixChecker.PromptTokens = promptTokens;
            PerformanceMatrixChecker.CompletionTokens = completionTokens;
            PerformanceMatrixChecker.ResponseTime = responseTime;
            PerformanceMatrixChecker.TotalTokens = totalTokens;
            PerformanceMatrixChecker.Cost = cost;
            PerformanceMatrixChecker.PublicInfo = publicinfo;
            if (responsibleAIAssessment !== null && responsibleAIAssessment !== '') {
                PerformanceMatrixChecker.Hallucination = responsibleAIAssessment.hallucinationResponse !== null ? responsibleAIAssessment.hallucinationResponse.ungroundedDetected : null;
                PerformanceMatrixChecker.HallucinationScore = responsibleAIAssessment.hallucinationResponse !== null ? responsibleAIAssessment.hallucinationResponse.ungroundedPercentage : null;
                PerformanceMatrixChecker.Plagiarism = responsibleAIAssessment.plagiarismRes !== null ? responsibleAIAssessment.plagiarismRes.protectedMaterialAnalysis.detected : null;
                PerformanceMatrixChecker.PromptInjection = responsibleAIAssessment.promptInjectionRes !== null ? (responsibleAIAssessment.promptInjectionRes.userPromptAnalysis !== null ? responsibleAIAssessment.promptInjectionRes.userPromptAnalysis.attackDetected : null) : null;
                PerformanceMatrixChecker.HateSeverity = responsibleAIAssessment.toxicityRes !== null ? responsibleAIAssessment.toxicityRes.hateScore : null;
                PerformanceMatrixChecker.SelfHarmSeverity = responsibleAIAssessment.toxicityRes !== null ? responsibleAIAssessment.toxicityRes.selfHarmScore : null;
                PerformanceMatrixChecker.SexualSeverity = responsibleAIAssessment.toxicityRes !== null ? responsibleAIAssessment.toxicityRes.sexualScore : null;
                PerformanceMatrixChecker.ViolenceSeverity = responsibleAIAssessment.toxicityRes !== null ? responsibleAIAssessment.toxicityRes.violenceScore : null;
                if (responsibleAIAssessment.hallucinationResponse !== null) {
                    hallucinationDetailsJson = JSON.stringify(responsibleAIAssessment.hallucinationResponse.ungroundedDetails);
                }
            }
            $.ajax({
                // url: '/Admin/AddPerformanceMatrixChecker',
                url: '@Url.Action("AddPerformanceMatrixChecker", "Admin", new { Area = "" })',
                type: 'post',
                data: { performance: PerformanceMatrixChecker },
                success: function (response) {
                    if (response == "0") {
                        window.location.href = '@Url.Action("Index", "Login", new { Area = "" })';
                    }
                    else {
                        PerformanceId = response;

                        var targetDiv = $(PerID);
                        var currentHtml = targetDiv.html();
                        var updatedHtml = currentHtml.replace(/PerformID/gi, PerformanceId);
                        targetDiv.html(updatedHtml);
                    }
                },
                error: function (error) {
                    $(".typing-gif").css("display", "none");
                    $('#btnS').prop('disabled', false);
                    $('#inputPrompt').prop('disabled', false);
                }
