@section JSForThisPage
{
    <script>
        var _BankingEnable = false;
        var dynamicString;
        var dataSource = [];
        var labelName = [];
        var msgText = "";
        var CacheVal = 0;
        var streamVal = "";
        var streamVal2 = "";
        var streamVal3 = "";
        var excelDownload = "";
        var PerID = "";
        var PerformanceId = 0;
        var stopTyping = false;
        var showBtn = "";
        var ResponsibleAiAssessment;

        var responseTime;
        var currentTime;
        var promptTokens;
        var completionTokens;
        var totalTokens;
        var cost;
        var contentSaftey;
        var publicinfo;
        var responseCounter = 1;
        var responseData = [];
        var isResponseEnd = 0;
        var message = '';
        var newSugg1 = '';
        var newSugg2 = '';
        var newSugg3 = '';
        var flag = 1;
        var statusVal = 0;
        var isUserScrolling = false;
        var streamingOnOff = false;

        // Icons made by Freepik from www.flaticon.com
        const BOT_IMG = "https://image.flaticon.com/icons/svg/327/327779.svg";
        const PERSON_IMG = "https://image.flaticon.com/icons/svg/145/145867.svg";
        const BOT_NAME = "@ViewBag.OrganizationName";
        const PERSON_NAME = "Your Question";

        const msgerForm = get(".msger-inputarea");
        const msgerInput = get(".msger-input");
        const msgerChat = get(".msger-chat");
        const msgerdrop = get(".msger-inputareadrop");
        var sourcemessage = [];

        $(document).ready(function () {
            var streamingValue = @Html.Raw(ViewBag.Streaming == null ? "null" : ViewBag.Streaming.ToString().ToLower());

            if (streamingValue === 1) {
                streamingOnOff = true;
            } else {
                streamingOnOff = false;
            }

            getModelName();
        });

        function getModelName() {
            $.ajax({

                // url: '/Banking/BankBot/GetModelName',
                url: '@Url.Action("GetModelName", "BankBot", new { Area = "Banking" })',
                type: 'GET',
                success: function (models) {
                    var selectedModelId = $("#myselect").val();
                    $("#myselect").empty();

                    models.forEach(function (m) {
                        if (m.status === 1) {
                            var modelId = m.id;
                            var modelName = m.modelName;
                            var size = m.size;
                            var displayText = modelName + " (" + size + ")";

                            $("#myselect").append("<option value='" + modelId + "'>" + displayText + "</option>");
                        }
                    });
                    if (!selectedModelId || !models.some(m => m.id == selectedModelId)) {
                        var firstModelWithStatus1 = models.find(m => m.status === 1);
                        $("#myselect").val(firstModelWithStatus1.id);  // Select the first model with status 1
                    } else {
                        // If the user has selected a model, keep it selected
                        $("#myselect").val(selectedModelId);
                    }


                },
                error: function (xhr, status, error) {
                    console.error('Error occurred: ' + error);
                }
            });
        }

        function selectvalue() {

            var selEl = document.querySelector('#myselect');
            var op = selEl.value;
            return op;
        }

        function getvalue() {

            if (msgerInput.value) {
                var mesgtext = msgerInput.value.trim();
            }
            return mesgtext
        }

        msgerForm.addEventListener("submit", event => {
            event.preventDefault();
            msgText = getvalue();
            if (!msgText) return;

            $('#btnS').prop('disabled', true);
            $('#inputPrompt').prop('disabled', true);
            appendMessage(PERSON_NAME, PERSON_IMG, "right", msgText, "", "", "");

            $(".typing-gif").css("display", "inline-block");
            msgerInput.value = "";
            botResponse(msgText);
        });

        function datavalidation(chatReply, UserPrompt, PerformanceID) {
            var _botReply = chatReply.outerText;
            var _UserPrompt = UserPrompt.outerText;
            var buttonlike = document.getElementById("likeBtn");
            var buttonValue = "True";

            if (buttonValue.trim() !== "") {
                $.ajax({
                    // url: '/Home/FeedbackData',
                    url: '@Url.Action("FeedbackData", "Home", new { Area = "" })',
                    type: 'POST',
                    dataType: 'json',
                    data: { IsValid: "True", Prompt: _UserPrompt, Completion: _botReply, CustomerId: @ViewBag.CustomerId, ModelName: selectvalue(), PerformanceID: PerformanceID },
                    success: function (data) {

                        alert("Feedback taken Successfully !!");
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        console.log(textStatus, errorThrown);
                    }
                });

            }
            else {
                console.log("Button value is empty");
            }
        }
        function datavalidationfalse(chatReply, UserPrompt, PerformanceID) {
            var _botReply = chatReply.outerText;
            var _UserPrompt = UserPrompt.outerText;
            var buttonlike = document.getElementById("likeBtn");
            var buttonValue = "True";

            if (buttonValue.trim() !== "") {
                $.ajax({
                    // url: '/Home/FeedbackData',
                    url: '@Url.Action("FeedbackData", "Home", new { Area = "" })',
                    type: 'POST',
                    dataType: 'json',
                    data: { IsValid: "False", Prompt: _UserPrompt, Completion: _botReply, CustomerId: @ViewBag.CustomerId, ModelName: selectvalue(), PerformanceID: PerformanceID },
                    success: function (data) {

                        alert("Feedback taken Successfully !!");
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        console.log(textStatus, errorThrown);
                    }
                });

            }
            else {
                console.log("Button value is empty");
            }
        }

        function suggestedprompt(id) {
            msgText = $("#" + id).text();

            appendMessage(PERSON_NAME, PERSON_IMG, "right", msgText, "", "", "");

            $(".typing-gif").css("display", "inline-block");
            msgerInput.value = "";

