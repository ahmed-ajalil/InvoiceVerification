    <script>

        document.getElementById('inputPrompt').addEventListener('input', function (event) {
            var inputText = event.target.value.trim();
            if (inputText === "") {
                hideSuggestionsDropdown();
                return;
            }

            // Using jQuery's $.ajax to replace fetch
            $.ajax({
                // url: '/autocomplete',
                url: "@Url.Action("Autocomplete", "AiAssistantBot", new { Area = "AiAssistant" })",
                data: { input: inputText },
                type: 'GET',
                success: function (data) {
                    var filteredSuggestions = data.suggestions.filter(suggestion =>
                        suggestion.toLowerCase().includes(inputText.toLowerCase())
                    );

                    // Show or hide the suggestions dropdown based on whether filtered suggestions are available
                    if (filteredSuggestions.length > 0) {
                        showSuggestionsDropdown(filteredSuggestions);
                    } else {
                        hideSuggestionsDropdown();
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error fetching autocomplete suggestions:', error);
                    hideSuggestionsDropdown();
                }
            });
        });


        function showSuggestionsDropdown(suggestions) {
            var suggestionsDropdown = document.getElementById('suggestionsDropdown');
            suggestionsDropdown.innerHTML = '';

            // Populate dropdown with suggestions
            suggestions.forEach(function (suggestion) {
                var suggestionElement = document.createElement('div');

                suggestionElement.textContent = suggestion;
                suggestionElement.classList.add('suggestion');
                suggestionElement.classList.add('text-info');
                suggestionElement.classList.add('mt-2');
                suggestionElement.addEventListener('click', function () {
                    // Update textbox value with the clicked suggestion
                    document.getElementById('inputPrompt').value = suggestion;
                    hideSuggestionsDropdown();
                });
                suggestionsDropdown.appendChild(suggestionElement);
            });

            // Display suggestions dropdown
            suggestionsDropdown.style.display = 'block';
        }

        // Function to hide suggestions dropdown
        function hideSuggestionsDropdown() {
            document.getElementById('suggestionsDropdown').style.display = 'none';
        }

    </script>
