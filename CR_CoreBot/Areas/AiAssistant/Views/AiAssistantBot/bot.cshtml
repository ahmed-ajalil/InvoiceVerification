    /* Popup container - can be anything you want */
    .popup {
        position: relative;
        display: inline-block;
        cursor: pointer;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
    }

        /* The actual popup */
        .popup .popuptext {
            visibility: hidden;
            /* background-color: #ced4da; */
            color: #fff;
            text-align: center;
            border-radius: 12px;
            padding: 1px 1px;
            position: absolute;
            z-index: 999;
            bottom: 125%;
            left: 50%;
            margin-left: -80px;
        }

            /* Popup arrow */
            .popup .popuptext::after {
                content: "";
                position: absolute;
                top: 100%;
                left: 10%;
                margin-left: -5px;
                border-width: 5px;
                border-style: solid;
                border-color: #555 transparent transparent transparent;
            }

        /* Toggle this class - hide and show the popup */
        .popup .show {
            visibility: visible;
            -webkit-animation: fadeIn 1s;
            animation: fadeIn 1s;
            width: 60vw;
            cursor: auto;
            /* box-shadow: 0px 0px 10px 2px #e9e9ef75; */
            border: 0;
            /* padding: 21px; */
            margin: 5px -40px;
        }

    .card-rounded {
        border-radius: 12px;
    }

    Toxi {
        background-color: #f5f5f5;
    }
</style>
