                            $(showBtn).show();
                        }
                    }
                }
                else {
                    clearInterval(interval);
                }
            }, speed);
        }

        function splitTextIntoArray(text) {
            // Define the keywords
            const thoughtProcess = 'Thought Process';
            const conclusion = 'Conclusion';

            // Find the positions of the keywords
            const startThoughtProcess = text.indexOf(thoughtProcess);
            const endThoughtProcess = startThoughtProcess + thoughtProcess.length;
            const startConclusion = text.indexOf(conclusion);
            const endConclusion = startConclusion + conclusion.length;

            // Split the text into parts
            const part1 = text.substring(startThoughtProcess, endThoughtProcess).trim();
            const part2 = text.substring(endThoughtProcess, startConclusion).trim();
            const part3 = text.substring(startConclusion, endConclusion).trim();
            const part4 = text.substring(endConclusion).trim();

            return [part1, part2, part3, part4];
        }

        function getRandomInt(min, max) {
            return Math.floor(Math.random() * (max - min + 1)) + min;
        }

        async function typeEffect3(element, text, speed) {
            var formattedText = '';
            var arrLen = 0;
            const resultArray = splitTextIntoArray(text);
            arrLen = resultArray.length;
            for (var j = 0; j < resultArray.length; j++) {
                var RespnsDiv = "ResDiv_" + getRandomInt(1, 10000) + "_" + getRandomInt(1, 10000);

                if (resultArray[j] == 'Thought Process') {
                    $(element).append("<div id=" + RespnsDiv + " class='mb-3 textZero'></div>");
                } else if (resultArray[j] == 'Conclusion') {
                    $(element).append("<div id=" + RespnsDiv + " class='fw-bold textOne'></div>");
                } else {
                    if (j == arrLen - 1) {
                        $(element).append("<div id=" + RespnsDiv + " class='fw-bold textOne'></div>");
                    }
                    else {
                        $(element).append("<div id=" + RespnsDiv + " class='mb-3 textZero'></div>");
                    }
                }
                if (resultArray[j] == 'Thought Process') {
                    $("#" + RespnsDiv).append('<div class="btTitlebox"><span><img src="@Url.Content("~/content/assets/images/icons/mindset.png")" height="27"/>Thought Process</span></div>');

                }
                else if (resultArray[j] == 'Conclusion') {
                    $("#" + RespnsDiv).append('<div class="btTitlebox"><span><img src="@Url.Content("~/content/assets/images/icons/results.png")" height="27"/>Conclusion</span></div>');

                }
                else {
                    if (j == arrLen - 1) {
                        await appendText(RespnsDiv, resultArray[j], speed, true);
                    }
                    else {
                        await appendText(RespnsDiv, resultArray[j], speed, false);
                    }
                }
            }
        }

        function appendText(element, text, speed, flag) {

            if (stopTyping == false) {
                $("#btnStop").show();
            }
            else {
                $("#btnStop").hide();
            }

            return new Promise((resolve) => {
                var i = 0;
                var interval = setInterval(function () {
                    if (i < text.length) {
                        var currentChar = text.charAt(i);
                        if (currentChar === '<') {
                            var closingIndex = text.indexOf('>', i) + 1;
                            var htmlTag = text.substring(i, closingIndex);
                            if (stopTyping == false) {
                                $("#" + element).append(htmlTag);
                            }
                            i = closingIndex;
                        } else {
                            if (stopTyping == false) {
                                $("#" + element).append(currentChar);
                            }
                            i++;
                        }
                        if (stopTyping == true) {
                            i = text.length;
                        }
                        htmlscrollToBottom();
                    }
                    else {
                        $("#btnStop").hide();
                        if (flag == true && stopTyping == false) {
                            setmessageSuggestion(newSugg1, newSugg2, newSugg3);
                            newSugg1 = '';
                            newSugg2 = '';
                            newSugg3 = '';
                            $('#btnS').prop('disabled', false);
                            $('#inputPrompt').prop('disabled', false);
                        }
                        clearInterval(interval);
                        resolve();
                    }
                }, speed);
            });
        }


