            }
            if (stopTyping == false) {
                $("#btnStop").show();
            }
            else {
                $("#btnStop").hide();
            }

            var interval = setInterval(function () {
                if (i < text.length) {
                    if (stopTyping == false) {
                        $("#" + RespnsDiv).append(text.charAt(i));
                    }
                    i++;
                    htmlscrollToBottom();

                    if (i >= text.length && status == 0) {
